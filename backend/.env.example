APP_NAME=Open Layer Observability API
API_PREFIX=/api

# Database Configuration:
# For instant local development (default):
DATABASE_URL=sqlite:///./open_layer.db

# For local or cloud MySQL:
# DATABASE_URL=mysql+pymysql://open_layer_user:change_this_password@127.0.0.1:3306/open_layer?charset=utf8mb4

# For cloud PostgreSQL (e.g. Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/open_layer

SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-vercel-domain.vercel.app
SEED_DEMO_DATA=true
